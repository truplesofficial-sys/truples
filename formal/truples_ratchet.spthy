theory Truples_Enterprise_Double_Ratchet
begin

builtins: hashing, asymmetric-encryption, signing, diffie-hellman, symmetric-encryption

// Axiom: Strict Cryptographic Equality Enforcement
restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

/*
 * Truples Enterprise Double Ratchet Formal Protocol Specification
 * Modelled for Tamarin Prover
 *
 * Formal Security Proof Targets:
 * 1. Session Reachability (Handshake Completes)
 * 2. Directional Chain Isolation (SendChain != RecvChain)
 * 3. Strict Forward Secrecy (FS) against historical state compromise
 * 4. Post-Compromise Security (PCS) self-healing via Ephemeral DH
 */

// 1. Long-Term Identity Key Generation
rule Generate_Identity_Key:
    [ Fr(~ltk) ]
  -->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

// 2. Ephemeral Prekey & Authenticated Handshake (Alice -> Bob)
rule Handshake_Init:
    let
      signedEcdh = sign(<'ECDH_INIT', ~ephA>, ~ltkA)
    in
    [ !Ltk($A, ~ltkA), Fr(~ephA) ]
  -->
    [ Init_1($A, $B, ~ephA), Out(<'HANDSHAKE_INIT', $A, 'g'^~ephA, signedEcdh>) ]

// 3. Bob Receives Handshake, Verifies Signature & Establishes Root/Directional Chains
rule Handshake_Resp:
    let
      signedEcdhB = sign(<'ECDH_RESP', ~ephB>, ~ltkB)
      sharedSecret = pkA_eph^~ephB
      rootKey = h(<'Truples-Root-Key', sharedSecret>)
      sendChain = h(<'Truples-Chain-Resp-To-Init', sharedSecret>)
      recvChain = h(<'Truples-Chain-Init-To-Resp', sharedSecret>)
    in
    [ !Ltk($B, ~ltkB), !Pk($A, pkA), Fr(~ephB), In(<'HANDSHAKE_INIT', $A, pkA_eph, sigA>) ]
  --[
      Eq(verify(sigA, <'ECDH_INIT', pkA_eph>, pkA), true),
      SessionEstablished($B, $A, rootKey, sendChain, recvChain),
      DirectionalKeys($B, $A, sendChain, recvChain)
    ]->
    [ Active_Session($B, $A, rootKey, sendChain, recvChain, ~ephB, pkA_eph),
      Out(<'HANDSHAKE_RESP', $B, 'g'^~ephB, signedEcdhB>) ]

// 4. Alice Finalizes Handshake & Aligns Chains (Alice.Send == Bob.Recv)
rule Handshake_Finalize:
    let
      sharedSecret = pkB_eph^~ephA
      rootKey = h(<'Truples-Root-Key', sharedSecret>)
      sendChain = h(<'Truples-Chain-Init-To-Resp', sharedSecret>)
      recvChain = h(<'Truples-Chain-Resp-To-Init', sharedSecret>)
    in
    [ Init_1($A, $B, ~ephA), !Pk($B, pkB), In(<'HANDSHAKE_RESP', $B, pkB_eph, sigB>) ]
  --[
      Eq(verify(sigB, <'ECDH_RESP', pkB_eph>, pkB), true),
      SessionEstablished($A, $B, rootKey, sendChain, recvChain),
      DirectionalKeys($A, $B, sendChain, recvChain)
    ]->
    [ Active_Session($A, $B, rootKey, sendChain, recvChain, ~ephA, pkB_eph) ]

// 5. Symmetric Message Ratchet Step (Per-Message Forward Secrecy)
rule Send_Message_Ratcheted:
    let
      msgKey = h(<'Truples-Message-Key', sendChain>)
      nextSendChain = h(<'Truples-Chain-Step', sendChain>)
      ciphertext = senc(~msg, msgKey)
    in
    [ Active_Session($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh), Fr(~msg) ]
  --[
      MessageSent($A, $B, ~msg, msgKey),
      Secret($A, $B, ~msg)
    ]->
    [ Active_Session($A, $B, rootKey, nextSendChain, recvChain, ~localDh, remoteDh), Out(ciphertext) ]

// 6. Adversary Compromises Actor State (linear: Active -> Compromised, no loop)
rule Adversary_Compromise_State:
    [ Active_Session($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh) ]
  --[
      StateCompromised($A),
      CompromisedAt($A, rootKey, sendChain)
    ]->
    [
      Compromised_Session($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh),
      Out(<rootKey, sendChain, recvChain, ~localDh>)
    ]

// 7. Asymmetric DH Ratchet Turn-Taking Step (Post-Compromise Security Recovery)
rule Ephemeral_DH_Ratchet_Turn:
    let
      newSharedSecret = remoteDh^~freshDh
      newRootKey = h(<'Truples-DH-Ratchet-Root-Step', rootKey, newSharedSecret>)
      newSendChain = h(<'Truples-DH-Ratchet-Init-To-Resp', newSharedSecret>)
      newRecvChain = h(<'Truples-DH-Ratchet-Resp-To-Init', newSharedSecret>)
    in
    [ Compromised_Session($A, $B, rootKey, sendChain, recvChain, ~oldDh, remoteDh), Fr(~freshDh) ]
  --[
      DHRatchetStep($A, $B, rootKey, newRootKey),
      PCSHealed($A, $B, newRootKey)
    ]->
    [ Active_Session($A, $B, newRootKey, newSendChain, newRecvChain, ~freshDh, remoteDh), Out('g'^~freshDh) ]

// =========================================================================
// FORMAL SECURITY LEMMAS & MATHEMATICAL INVARIANTS
// =========================================================================

// Lemma 1: Session Reachability (Existential - fast to verify)
lemma Session_Reachability:
  exists-trace
    "Ex A B rk send recv #i.
        SessionEstablished(A, B, rk, send, recv) @ #i"

// Lemma 2: Directional Chain Separation (SendChain !== RecvChain)
lemma Directional_Key_Separation:
    "All A B send recv #i.
        DirectionalKeys(A, B, send, recv) @ #i
        ==> not (send = recv)"

// Lemma 3: Strict Temporal Forward Secrecy (Historical Message Secrecy after State Compromise)
lemma Forward_Secrecy:
    "All A B m key #i #j.
        MessageSent(A, B, m, key) @ #i &
        StateCompromised(A) @ #j &
        #i < #j
        ==> not (Ex #k. K(m) @ #k)"

// Lemma 4: Post-Compromise Security (Adversary Locked Out after Fresh DH Ratchet Turn)
lemma Post_Compromise_Security:
    "All A B rk_old rk_new #i #j.
        StateCompromised(A) @ #i &
        DHRatchetStep(A, B, rk_old, rk_new) @ #j &
        #i < #j
        ==> not (Ex #l. K(rk_new) @ #l)"

end
