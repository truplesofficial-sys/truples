theory Truples_Enterprise_Double_Ratchet
begin

builtins: hashing, symmetric-encryption, signing, diffie-hellman

// Axiom: Strict Cryptographic Equality Enforcement
restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

// Restriction: Each actor generates their identity key exactly once
restriction OnlyOneKeyPerActor:
    "All A ltk1 ltk2 #i #j.
        GenKey(A, ltk1) @ #i & GenKey(A, ltk2) @ #j ==> #i = #j"

/*
 * Truples Enterprise Double Ratchet - Formal Security Specification (TRP-002 & TRP-004 Exact Transition Graph)
 *
 * Models the rigorous 5-stage Double Ratchet State Machine with Causal Fact Passing:
 * 1. Long-term ECDSA Identity Binding with canonical transcript authentication
 * 2. Directional chain isolation (sendChain != recvChain)
 * 3. Temporal State Compromise at Epoch N
 * 4. Bob Ephemeral Rotation (Bob generates ~freshBobDh -> Bob_Wire_Turn fact emitted)
 * 5. Alice Receives Bob's ~freshBobDh -> Alice_Pending_DH_Turn fact consumed
 * 6. Alice Fresh Ephemeral Rotation (Alice generates ~freshAliceDh -> healedDH = freshBobDh^~freshAliceDh)
 */

// 1. Long-Term Identity Key Generation
rule Generate_Identity_Key:
    [ Fr(~ltk) ]
  --[ GenKey($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

// 2. Initiator sends handshake with canonical transcript binding (TRP-004)
rule Handshake_Init:
    let
      transcript = <'TRUPLES-HANDSHAKE-v2', '1', 'initiator', $A, $B, 'g'^~ephA, ~salt>
    in
    [ !Ltk($A, ~ltkA), Fr(~ephA), Fr(~salt) ]
  --[ InitStarted($A, $B) ]->
    [ Init_1($A, $B, ~ephA, ~ltkA, ~salt),
      Out(<'INIT', $A, 'g'^~ephA, ~salt, sign(transcript, ~ltkA)>) ]

// 3. Responder processes handshake and establishes session
rule Handshake_Resp:
    let
      initTranscript = <'TRUPLES-HANDSHAKE-v2', '1', 'initiator', $A, $B, pkA_eph, salt>
      respTranscript = <'TRUPLES-HANDSHAKE-v2', '1', 'responder', $B, $A, 'g'^~ephB, salt>
      sharedDH  = pkA_eph^~ephB
      rootKey   = h(<'rk', sharedDH, salt>)
      sendChain = h(<'sc', sharedDH, salt>)
      recvChain = h(<'rc', sharedDH, salt>)
    in
    [ !Ltk($B, ~ltkB), !Pk($A, pkA), Fr(~ephB),
      In(<'INIT', $A, pkA_eph, salt, sigA>) ]
  --[
      Eq(verify(sigA, initTranscript, pkA), true),
      SessionKey($B, $A, rootKey),
      DirectionalKeys($B, $A, sendChain, recvChain)
    ]->
    [ Session_Active($B, $A, rootKey, sendChain, recvChain, ~ephB, pkA_eph),
      Out(<'RESP', $B, 'g'^~ephB, sign(respTranscript, ~ltkB)>) ]

// 4. Initiator finalizes session
rule Handshake_Finalize:
    let
      respTranscript = <'TRUPLES-HANDSHAKE-v2', '1', 'responder', $B, $A, pkB_eph, salt>
      sharedDH  = pkB_eph^~ephA
      rootKey   = h(<'rk', sharedDH, salt>)
      sendChain = h(<'sc', sharedDH, salt>)
      recvChain = h(<'rc', sharedDH, salt>)
    in
    [ Init_1($A, $B, ~ephA, ~ltkA, salt), !Pk($B, pkB),
      In(<'RESP', $B, pkB_eph, sigB>) ]
  --[
      Eq(verify(sigB, respTranscript, pkB), true),
      SessionKey($A, $B, rootKey),
      DirectionalKeys($A, $B, sendChain, recvChain)
    ]->
    [ Session_Active($A, $B, rootKey, sendChain, recvChain, ~ephA, pkB_eph) ]

// 5. Send a message (symmetric ratchet step with authenticated AAD header binding)
rule Send_Message:
    let
      msgKey        = h(<'mk', sendChain>)
      nextSendChain = h(<'ns', sendChain>)
      aad           = <'AAD', remoteDh>
    in
    [ Session_Active($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh), Fr(~m) ]
  --[ MsgSent($A, $B, ~m, msgKey), MsgSent_AAD($A, $B, ~m, aad, msgKey), Secret($A, $B, ~m) ]->
    [ Session_Active($A, $B, rootKey, nextSendChain, recvChain, ~localDh, remoteDh),
      Out(<senc(<~m, aad>, msgKey), aad>) ]

// 6. Adversary compromises state (Linear state transition: Active -> Compromised)
rule Compromise:
    [ Session_Active($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh) ]
  --[ Compromised($A) ]->
    [ Compromised_Session($A, $B, rootKey, sendChain, recvChain, ~localDh, remoteDh),
      Out(<rootKey, sendChain, recvChain, ~localDh>) ]

// 7. Bob Ephemeral Rotation (Intermediate Turn: Bob rotates fresh ~freshBobDh)
rule Bob_Turn_Ephemeral_Rotation:
    let
      intermediateDH      = pkA^~freshBobDh
      intermediateRootKey = h(<'inter_rk', rootKey, intermediateDH>)
      newSendChain        = h(<'nsc', intermediateDH>)
      newRecvChain        = h(<'nrc', intermediateDH>)
    in
    [ Session_Active($B, $A, rootKey, sendChain, recvChain, ~oldBobDh, pkA), Fr(~freshBobDh) ]
  --[ BobTurnRotated($B, $A, intermediateRootKey), Out_Bob_Fresh_DH($B, $A, 'g'^~freshBobDh) ]->
    [ Session_Active($B, $A, intermediateRootKey, newSendChain, newRecvChain, ~freshBobDh, pkA),
      Bob_Wire_Turn($B, $A, 'g'^~freshBobDh),
      Out('g'^~freshBobDh) ]

// 8. Alice Receives Bob's Fresh DH and enters Pending DH Turn (Causal Fact Binding)
rule Alice_Receive_Bob_Fresh_DH:
    let
      intermediateDH      = pkB_fresh^~oldAliceDh
      intermediateRootKey = h(<'inter_rk', rootKey, intermediateDH>)
      newRecvChain        = h(<'nsc', intermediateDH>)
    in
    [ Compromised_Session($A, $B, rootKey, sendChain, recvChain, ~oldAliceDh, pkB_old),
      Bob_Wire_Turn($B, $A, pkB_fresh) ]
  --[ AliceReceivedBobFresh($A, $B, pkB_fresh) ]->
    [ Alice_Pending_DH_Turn($A, $B, intermediateRootKey, sendChain, newRecvChain, ~oldAliceDh, pkB_fresh) ]

// 9. Alice Fresh Ephemeral Rotation & Full PCS Restoration (Alice rotates fresh ~freshAliceDh with Bob's pkB_fresh)
rule Alice_Fresh_Turn_PCS_Restore:
    let
      healedDH        = pkB_fresh^~freshAliceDh
      healedRootKey   = h(<'healed_rk', intermediateRootKey, healedDH>)
      healedSendChain = h(<'hsc', healedDH>)
      healedRecvChain = h(<'hrc', healedDH>)
    in
    [ Alice_Pending_DH_Turn($A, $B, intermediateRootKey, sendChain, recvChain, ~oldAliceDh, pkB_fresh), Fr(~freshAliceDh) ]
  --[ DHRatchet($A, $B, intermediateRootKey, healedRootKey), PCSHealed($A, $B, healedRootKey) ]->
    [ Session_Active($A, $B, healedRootKey, healedSendChain, healedRecvChain, ~freshAliceDh, pkB_fresh),
      Out('g'^~freshAliceDh) ]

// =========================================================================
// MACHINE-CHECKED TAMARIN FORMAL VERIFICATION LEMMAS (Bounded Depth = 2)
// =========================================================================

// Lemma 1: Protocol reachability (Handshake establishes valid session)
lemma Session_Reachability:
  exists-trace
    "Ex A B rk #i. SessionKey(A, B, rk) @ #i"

// Lemma 2: Directional Chain Separation (sendChain != recvChain)
lemma Directional_Key_Separation:
    "All A B s r #i.
        DirectionalKeys(A, B, s, r) @ #i
        ==> not (s = r)"

// Lemma 3: Universal Forward Secrecy (Adversary cannot decrypt past messages)
lemma Forward_Secrecy:
    "All A B m mk #i #j.
        MsgSent(A, B, m, mk) @ #i &
        Compromised(A) @ #j &
        #i < #j
        ==> not (Ex #k. K(m) @ #k)"

// Lemma 4: Post-Compromise Security (Adversary locked out from healed root key after Alice fresh turn)
lemma Post_Compromise_Security:
    "All A B rk_old rk_new #i #j.
        Compromised(A) @ #i &
        DHRatchet(A, B, rk_old, rk_new) @ #j &
        #i < #j
        ==> not (Ex #k. K(rk_new) @ #k)"

// Lemma 5: Post-Healing Message Secrecy (Future messages locked out from past attacker)
lemma Future_Message_Secrecy_After_Healing:
    "All A B rk_old rk_new m mk #i #j #k.
        Compromised(A) @ #i &
        DHRatchet(A, B, rk_old, rk_new) @ #j &
        MsgSent(A, B, m, mk) @ #k &
        #i < #j & #j < #k
        ==> not (Ex #l. K(m) @ #l)"

end
